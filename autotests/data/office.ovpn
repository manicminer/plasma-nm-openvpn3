##
# Synthetic test profile for example.org - not a real VPN.
##
client
dev tun
proto udp
remote vpn1.example.org 1194 udp
remote vpn2.example.org 443 tcp

; failover entry, kept verbatim by the editor
<connection>
remote fallback.example.org 1194 udp
http-proxy proxy.example.org 8080
</connection>

ca pki/ca.crt
cert pki/client.crt
key pki/client.key
tls-auth pki/ta.key 1
auth-user-pass creds.txt

remote-cert-tls server
verify-x509-name "C=NO, O=Example Org, CN=vpn.example.org" subject
pull-filter ignore "redirect-gateway"
setenv opt 'single quoted value'
some-directive-we-have-never-heard-of 1 2 3
