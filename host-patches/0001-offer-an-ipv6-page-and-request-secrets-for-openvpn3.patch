+bool ConnectionEditorBase::shouldRequestVpnSecrets(const NetworkManager::VpnSetting::Ptr &setting)
+{
+    // Missing secret flags mean system-owned (None). The logical profile
+    // marker still requires a GetSecrets request when no -flags key exists.
+    if (setting->serviceType() == QLatin1String("org.freedesktop.NetworkManager.openvpn3")
+        && setting->data().value(QStringLiteral("profile-storage")) == QLatin1String("secret")
+        && !setting->data().contains(QStringLiteral("profile-flags"))) {
+        return true;
+    }
+    for (const QString &key : setting->data().keys()) {
+        if (key.endsWith(QStringLiteral("-flags"))) {
+            const auto flag = static_cast<NetworkManager::Setting::SecretFlagType>(setting->data().value(key).toInt());
+            if (flag == NetworkManager::Setting::None || flag == NetworkManager::Setting::AgentOwned) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+bool ConnectionEditorBase::hasIpv6Page(NetworkManager::ConnectionSettings::ConnectionType type, const QString &serviceType)
+{
+    switch (type) {
+    case NetworkManager::ConnectionSettings::Wired:
+    case NetworkManager::ConnectionSettings::Wireless:
+    case NetworkManager::ConnectionSettings::Infiniband:
+    case NetworkManager::ConnectionSettings::Team:
+    case NetworkManager::ConnectionSettings::Cdma:
+    case NetworkManager::ConnectionSettings::Gsm:
+    case NetworkManager::ConnectionSettings::Bond:
+    case NetworkManager::ConnectionSettings::Bridge:
+    case NetworkManager::ConnectionSettings::Vlan:
+    case NetworkManager::ConnectionSettings::WireGuard:
+    case NetworkManager::ConnectionSettings::Loopback:
+        return true;
+    case NetworkManager::ConnectionSettings::Vpn:
+        // Both OpenVPN services carry IPv6 and leave the addressing to
+        // NetworkManager, so there is something for the page to set.
+        return serviceType == QLatin1String("org.freedesktop.NetworkManager.openvpn")
+            || serviceType == QLatin1String("org.freedesktop.NetworkManager.openvpn3");
+    default:
+        return false;
+    }
+}
