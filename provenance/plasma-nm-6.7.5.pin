# Pinned plasma-nm revision the private editor headers come from.
#
# plasma-nm installs libplasmanm_editor.so but none of its headers, gives the
# library no SOVERSION and ships no pkg-config file, so nothing about an
# installed plasma-nm says which ABI it is.  This module is therefore built
# against the headers of one exact upstream revision and refuses to build
# against an installed plasma-nm of any other version.
#
# The revision is content-addressed: a git commit hash covers the tree it
# names, so fetching this commit from any mirror yields these exact headers or
# fails.  plasma-nm-6.7.5.sha256 digests the four files that are actually used,
# which is checked again whatever the source tree came from -- a fetched clone
# and a local checkout are verified alike.
#
# version         upstream release this matches, and the only installed
#                 plasma-nm version the build accepts without an override
# repository      canonical upstream (github.com/KDE/plasma-nm is a mirror of
#                 the same history and serves the same commit)
# commit          immutable revision; equals the peeled v6.7.5 tag
# tag             the release tag that peels to that commit
# license         license of the headers this pin covers; they are read at
#                 build time and never redistributed by this project

version = 6.7.5
repository = https://invent.kde.org/plasma/plasma-nm.git
mirror = https://github.com/KDE/plasma-nm.git
commit = af9d0f5386a0a2c340e1392689795b2fdbd60035
tag = v6.7.5
license = LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
